# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://kbeautymatch.com

# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Optional explicit ref (otherwise derived from URL hostname)
# SUPABASE_PROJECT_REF=
# Known Production ref for inequality checks (do not point Preview here)
# PRODUCTION_SUPABASE_PROJECT_REF=rhfrmvkjsummaylpzmns

# App / catalog environment separation
# Production: APP_ENV=production CATALOG_DATABASE_ENV=production CATALOG_INGESTION_ENABLED=false
# Preview staging: APP_ENV=preview CATALOG_DATABASE_ENV=staging CATALOG_INGESTION_ENABLED=true
# APP_ENV=preview
# CATALOG_DATABASE_ENV=staging
# CATALOG_INGESTION_ENABLED=false
# CATALOG_CRON_ENABLED=false
# CATALOG_DRY_RUN=true
# CATALOG_AUTO_PROMOTE=false
# CATALOG_MAX_PRODUCTS_PER_SOURCE=20

# AI (production: openai or anthropic — mock forbidden)
AI_PROVIDER=openai
OPENAI_API_KEY=

# Optional
# SITE_URL=https://kbeautymatch.com

# Email delivery (server-only — never prefix with NEXT_PUBLIC_)
# EMAIL_DELIVERY_MODE=disabled  # disabled | dry_run | live (default unset=disabled)
# EMAIL_PROVIDER=none  # none | dry_run | resend
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=  # e.g. K-Beauty Match <care@updates.kbeautymatch.com>
# EMAIL_STAGING_RECIPIENT_ALLOWLIST=  # comma-separated staging-only recipients
# EMAIL_LIVE_KILL_SWITCH=false  # must be true for live (Production still blocked)
# Uses NEXT_PUBLIC_SITE_URL or SITE_URL for server site URL (existing)

# Preview unified review remote JSON (server-only · HTTPS · ignored in Production)
# Prefer auto: VERCEL_ENV=preview uses https://$VERCEL_URL/api/public/unified-review-manifest
# Or set explicitly:
# UNIFIED_REVIEW_MANIFEST_URL=https://your-preview.vercel.app/api/public/unified-review-manifest

# ENABLE_HSTS=true
# OPENAI_MODEL=
# AI_MAX_TOKENS=
