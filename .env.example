# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://kbeautymatch.com

# Server-only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Optional explicit ref (otherwise derived from URL hostname)
# SUPABASE_PROJECT_REF=
# Known Production ref for inequality checks (do not point Preview here)
# PRODUCTION_SUPABASE_PROJECT_REF=rhfrmvkjsummaylpzmns

# App / catalog environment separation
# Production: APP_ENV=production CATALOG_DATABASE_ENV=production CATALOG_INGESTION_ENABLED=false
# Preview staging: APP_ENV=preview CATALOG_DATABASE_ENV=staging CATALOG_INGESTION_ENABLED=true
# APP_ENV=preview
# CATALOG_DATABASE_ENV=staging
# CATALOG_INGESTION_ENABLED=false
# CATALOG_CRON_ENABLED=false
# CATALOG_DRY_RUN=true
# CATALOG_AUTO_PROMOTE=false
# CATALOG_MAX_PRODUCTS_PER_SOURCE=20

# AI (production: openai or anthropic — mock forbidden)
AI_PROVIDER=openai
OPENAI_API_KEY=

# Optional
# SITE_URL=https://kbeautymatch.com
# ENABLE_HSTS=true
# OPENAI_MODEL=
# AI_MAX_TOKENS=
