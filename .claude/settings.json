{
  "permissions": {
    "deny": [
      "Read(.env)", "Read(.env.local)", "Read(.env.production)",
      "Read(**/.env)", "Read(**/.env.local)", "Read(**/.env.production)",
      "Edit(.env)", "Edit(.env.local)", "Edit(.env.production)",
      "Edit(**/.env)", "Edit(**/.env.local)", "Edit(**/.env.production)",
      "Write(.env)", "Write(.env.local)", "Write(.env.production)",
      "Bash(cat .env*)", "Bash(type .env*)",
      "Bash(git push --force*)", "Bash(git push -f*)",
      "Bash(git push origin main*)", "Bash(git push origin main:*)",
      "Bash(git push upstream main*)",
      "Bash(git merge main*)", "Bash(git merge origin/main*)",
      "Bash(git reset --hard*)", "Bash(rm -rf /*)", "Bash(rm -rf ~*)",
      "Bash(vercel --prod*)", "Bash(vercel deploy --prod*)", "Bash(npx vercel --prod*)",
      "Bash(supabase link --project-ref rhfrmvkjsummaylpzmns*)",
      "Bash(*rhfrmvkjsummaylpzmns*DELETE*)", "Bash(*rhfrmvkjsummaylpzmns*DROP*)",
      "Bash(*rhfrmvkjsummaylpzmns*TRUNCATE*)"
    ],
    "ask": [],
    "allow": [
      "Read", "Edit", "Write",
      "Bash(git status*)", "Bash(git log*)", "Bash(git diff*)",
      "Bash(git add*)", "Bash(git commit*)", "Bash(git push*)",
      "Bash(git checkout*)", "Bash(git branch*)",
      "Bash(npm install*)", "Bash(npm i *)", "Bash(npm run*)",
      "Bash(npm test*)", "Bash(npx tsc*)", "Bash(npx eslint*)",
      "Bash(curl*)", "Bash(wget*)", "Bash(rm*)",
      "Bash(supabase db push*)", "Bash(supabase db execute*)",
      "Bash(supabase migration up*)",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\"", "shell": "bash", "timeout": 10 }]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.sh\"", "shell": "bash", "timeout": 10 }]
      }
    ]
  }
}
