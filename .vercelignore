# Keep Preview deploys lean without breaking JSON imports under data/
node_modules
.next
.git
# Exclude all backup snapshots EXCEPT the 2026-07-14-catalog fixture, which is
# imported at build time by src/lib/recommend/scenarios/scenarioCoverageReport.ts.
# (Excluding all of data/backups previously broke the Vercel build with
#  "Module not found: data/backups/2026-07-14-catalog/products.json".)
data/backups/*
!data/backups/2026-07-14-catalog
data/catalog/full-beauty
data/catalog/enrichment
data/catalog/labels
data/catalog-import
data/pipeline
coverage
*.log
.env*
supabase/.temp
